# Public site URL used for canonical links, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.ps360.com

# Your Calendly scheduling page URL. Leave blank to show a fallback CTA
# instead of the embedded widget on the /contact page.
NEXT_PUBLIC_CALENDLY_URL=

# Resend (https://resend.com) API key used to email contact-form leads.
# Leave blank during development — submissions will be logged to the
# server console instead of sent.
RESEND_API_KEY=

# Inbox that should receive contact-form lead notifications.
# Defaults to the email set in src/lib/site-config.ts if omitted.
LEAD_NOTIFICATION_EMAIL=
